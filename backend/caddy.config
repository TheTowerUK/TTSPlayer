# TTSPlayer — Caddy HTTPS Static Server (M3.5)
#
# Serves catalog.json and media files for network client access.
# Path mapping spec: docs/architecture/path-mapping.md
# Deployment & smoke tests: docs/deployment/tnas-serving-layer.md
#
# Replace <YOUR_DOMAIN> with your NAS hostname (e.g. mediatnas.local).
# For home-network-only testing, add "tls internal" inside the site block.
#
# Install on TNAS:
#   caddy validate --config caddy.config
#   caddy run --config caddy.config

{
    email admin@<YOUR_DOMAIN>
}

<YOUR_DOMAIN> {
    # /volume1/Media/catalog.json
    handle /catalog.json {
        root * /volume1/Media
        file_server
        header Content-Type application/json
    }

    # /volume1/Media/scan.history.json (optional diagnostics)
    handle /scan.history.json {
        root * /volume1/Media
        file_server
        header Content-Type application/json
    }

    # Media files — MUST use handle_path so /media/Videos/foo.mp4
    # resolves to /volume1/Media/Videos/foo.mp4 (no extra /Media/ segment).
    handle_path /media/* {
        root * /volume1/Media

        # Allowlist synced with indexer.py SUPPORTED_EXTENSIONS
        @blocked not path *.mp4 *.mkv *.mov *.m4v *.avi *.jpg *.jpeg *.png *.webp *.gif *.bmp *.tif *.tiff
        respond @blocked 403

        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Accept-Ranges "bytes"
    }

    log {
        output file /var/log/caddy/ttsplayer.log
        format json
    }
}
