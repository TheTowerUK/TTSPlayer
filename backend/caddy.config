# TTSPlayer — Caddy Reverse Proxy Configuration
# Serves catalog.json and media files securely over HTTPS.
# Replace <YOUR_DOMAIN> and <TNAS_LOCAL_IP> with real values.
#
# Install Caddy on the TNAS, then run:  caddy run --config caddy.config

{
    # Global options
    email admin@<YOUR_DOMAIN>
}

<YOUR_DOMAIN> {
    # Serve the static catalog JSON
    handle /catalog.json {
        root * /volume1/media
        file_server
        header Content-Type application/json
    }

    # Serve media files (restrict to known extensions)
    handle /media/* {
        root * /volume1
        file_server
        @blocked not path *.mp4 *.mkv *.mov *.m4v *.jpg *.png
        respond @blocked 403
    }

    # Serve thumbnails
    handle /thumbs/* {
        root * /volume1/media
        file_server
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/ttsplayer.log
        format json
    }
}
